# AI-Meeting-Copilot Backend Environment Configuration

# Environment mode ('development' or 'production')
ENVIRONMENT=development

# Server Port (Render sets $PORT automatically; local default is 8000)
PORT=8000

# CORS Allowed Origins (comma-separated list of web origins allowed to call the API)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# CORS Allowed Origins Regex (e.g. allows all Vercel deployment and preview URLs)
CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$

# Whisper Speech-to-Text Model Configuration
# Use 'base' for local development; use 'tiny' for Render free instances (~512MB RAM).
WHISPER_MODEL=base
WHISPER_THREADS=4
# Set to 'false' to disable in-memory Whisper on extremely low-memory containers
WHISPER_ENABLED=true

# Local / Remote Ollama LLM Configuration
# NOTE: Render containers cannot reach your laptop's 'localhost:11434'.
# If deploying on Render, point OLLAMA_BASE_URL to an externally hosted Ollama server,
# or provide GROQ_API_KEY below for free cloud LLM inference.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60.0

# Optional Production Cloud LLM (Recommended for Render free tier where Ollama cannot run)
# Groq provides a generous free tier for Llama 3 models: https://console.groq.com
# GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Optional OpenAI-compatible Cloud LLM
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
